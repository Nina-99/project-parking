# FastAPI
PROJECT_NAME=Parking Intelligence System
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key

# Operator session. Override the password before exposing the API.
OPERATOR_USER=operator
OPERATOR_PASSWORD=operator
AUTH_COOKIE_SECURE=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://parking:parking@postgres:5432/parking
DATABASE_URL_SYNC=postgresql+psycopg://parking:parking@postgres:5432/parking

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Docker Postgres defaults
POSTGRES_DB=parking
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]

# YOLO
YOLO_MODEL_PATH=yolo26n.pt
YOLO_CONFIDENCE=0.5
DETECTION_INTERVAL_MS=500

# RTSP cameras
# Comma-separated list: id=url,id=url
# RTSP_CAMERAS=gate-1=rtsp://user:pass@192.168.1.100:554/stream1,gate-2=rtsp://user:pass@192.168.1.101:554/stream1
RTSP_CAMERAS=

# OCR
OCR_LANG=en

# OCR. Off until a reader is measured on the frozen test set.
OCR_ENABLED=false
OCR_READER=paddle
OCR_MIN_CONFIDENCE=0.60
OCR_CRNN_CHECKPOINT=/mnt/nina/SmartParking/runs/ocr_real_only_v2/crnn_stage2_real.pt
OCR_USE_GPU=false
OCR_LANG=latin

# Operations
PARKING_CAPACITY=0            # 0 = sin denominador; la UI muestra el conteo solo
CAMERA_OFFLINE_AFTER_SECONDS=20
