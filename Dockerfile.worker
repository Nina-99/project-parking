FROM python:3.12-slim

LABEL org.opencontainers.image.title="Parking Intelligence Worker"
LABEL org.opencontainers.image.description="Detection and classification worker"
LABEL org.opencontainers.image.authors="Nina"
LABEL org.opencontainers.image.licenses="Proprietary"

ENV UV_SYSTEM_PYTHON=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN pip install uv --quiet

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-editable

COPY backend/ ./backend/

CMD ["celery", "-A", "backend.worker.celery_app", "worker", "--loglevel=info", "--concurrency=1"]
